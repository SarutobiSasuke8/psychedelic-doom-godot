[gd_scene load_steps=2 format=3 uid="uid://pausemenu"]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.7)

[node name="VBox" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -80.0
offset_top = -60.0
offset_right = 80.0
offset_bottom = 60.0
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="VBox"]
theme_override_font_sizes/font_size = 22
text = "PAUSED"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="VBox"]
theme_override_font_sizes/font_size = 16
text = "RESUME"

[node name="MainMenu" type="Button" parent="VBox"]
theme_override_font_sizes/font_size = 16
text = "MAIN MENU"

[connection signal="pressed" from="VBox/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="VBox/MainMenu" to="." method="_on_main_menu_pressed"]
